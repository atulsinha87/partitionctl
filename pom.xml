<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator, and nothing more.

  It exists so that `mvn` at the repository root reaches the module: the Maven project lives
  in liquibase-partitionctl/, not at the root. Listing the module here is what makes
  `./mvnw clean install` at the root build it.

  It does NOT make the repository a Maven project. The root is a Go CLI; the Java extension
  under liquibase-partitionctl/ is a separate product that shares no code with it. This
  aggregator builds only the Java half and never touches the Go tree.

  `cd liquibase-partitionctl && mvn clean install` keeps working exactly as before.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.atulsinha87</groupId>
  <artifactId>partitionctl</artifactId>
  <version>0.1.4</version>
  <packaging>pom</packaging>

  <name>partitionctl</name>
  <description>Aggregator for the PartitionCTL Liquibase extension. The Go CLI in this
    repository is a separate product and is not built by Maven.</description>
  <url>https://github.com/atulsinha87/partitionctl</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/atulsinha87/partitionctl.git</connection>
    <developerConnection>scm:git:https://github.com/atulsinha87/partitionctl.git</developerConnection>
    <url>https://github.com/atulsinha87/partitionctl</url>
    <tag>v0.1.4</tag>
  </scm>

  <!--
    Never deployed. This aggregator exists only so `mvn` at the root can reach the
    module; it is not an artifact anyone should depend on, and it has no distributionManagement,
    so maven-deploy-plugin would fail the release trying to publish it. The extension module
    publishes itself through central-publishing-maven-plugin.
  -->
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <modules>
    <module>liquibase-partitionctl</module>
  </modules>
</project>
