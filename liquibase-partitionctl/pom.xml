<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.atulsinha87</groupId>
  <artifactId>liquibase-partitionctl</artifactId>
  <version>0.1.4</version>
  <packaging>jar</packaging>

  <name>liquibase-partitionctl</name>
  <description>Liquibase extension that creates indexes on partitioned PostgreSQL tables without
    blocking writes, by discovering the partition tree from the live catalog and driving
    CREATE INDEX CONCURRENTLY + ALTER INDEX ... ATTACH PARTITION per leaf.</description>
  <url>https://github.com/atulsinha87/partitionctl</url>

  <scm>
    <connection>scm:git:https://github.com/atulsinha87/partitionctl.git</connection>
    <developerConnection>scm:git:https://github.com/atulsinha87/partitionctl.git</developerConnection>
    <url>https://github.com/atulsinha87/partitionctl</url>
    <tag>v0.1.4</tag>
  </scm>

  <!-- Required by Maven Central. No email: the GitHub profile is the contact point. -->
  <developers>
    <developer>
      <id>atulsinha87</id>
      <name>Atul Sinha</name>
      <url>https://github.com/atulsinha87</url>
    </developer>
  </developers>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- API verified byte-identical across 4.0.0 -> 5.0.3; pinned for the build only. -->
    <liquibase.version>4.33.0</liquibase.version>
    <junit.version>5.8.2</junit.version>
  </properties>

  <dependencies>
    <!--
      PROVIDED, and it must stay provided. The host (Liquibase CLI, the maven plugin,
      Spring Boot, ...) already has liquibase-core on the classpath. Shipping it would
      let the jar override the host's own version. `unzip -l` on the built jar must
      show zero liquibase/** entries.
    -->
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
      <version>${liquibase.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Pinned, and it must stay pinned. Without an explicit version Maven supplies its own
        default, and that default varies by Maven version: 3.9.x gives compiler plugin 3.15.0,
        but older Mavens - JitPack's build image among them - give 3.1, which predates
        <release> support (added in 3.6). On 3.1 the maven.compiler.release property above is
        silently ignored, source/target fall back to 1.5, and any JDK 12 or newer refuses:

            Source option 5 is no longer supported. Use 7 or later.

        That is exactly how the first v0.1.0 JitPack build failed while `mvn clean install`
        passed here. Pinning the version is what makes the build reproducible off this machine.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>

      <!--
        Sources and javadoc are built on EVERY build, not behind a release profile.

        Maven Central requires both jars, and the javadoc one did not build at all: two doclint
        errors (a <table> with no <caption>, an <h2> under an implicit <h3>) had accumulated
        precisely because nothing ever ran javadoc. Deferring these to a release profile would
        reproduce that exact failure, with the first sighting arriving mid-release. They cost a
        few seconds, and CI now fails on a doclint regression instead.

        GPG signing and the Central upload stay out of the normal build; those belong in a
        release profile, tracked in issue #1.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    Publication to Maven Central, kept in a profile so that nothing here runs during an ordinary
    build. Signing needs a GPG key and a passphrase, and uploading needs a Central token; a
    contributor cloning this repository has neither, and `./mvnw clean install` must keep working
    for them without either. CI never activates this profile.

    Deploy with:  ./mvnw -Prelease deploy

    Prerequisites, all of them the project owner's and none of them in this repository:
      1. A Central Portal account with the io.github.atulsinha87 namespace verified.
      2. A GPG key whose public half is published to a keyserver, so Central can check it.
      3. ~/.m2/settings.xml holding a <server> with id "central" and the Portal token, plus
         gpg.passphrase (or a gpg-agent that supplies it).

    Central is IMMUTABLE: a released version can never be deleted, replaced or overwritten, only
    superseded by a higher one. Do not deploy a version that has not been exercised.
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <!--
              0.11.0, not 0.7.0. Central's API returns a "warnings" field that 0.7.0's response
              model does not declare, so Jackson throws UnrecognizedPropertyException and the build
              fails AFTER a successful upload and validation - the artifact is fine, the client
              cannot read the reply. Keep this current with the API.
            -->
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!--
                false: the upload is staged and waits for a human to release it in the Portal.
                Given that a released version is permanent, the last step stays manual.
              -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
