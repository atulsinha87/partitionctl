<?xml version="1.0" encoding="UTF-8"?>
<!-- The prefixed child form. Both <column/> and <ext:column/> must bind. -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext/partitionctl"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                            http://www.liquibase.org/xml/ns/dbchangelog-ext/partitionctl
                            http://www.liquibase.org/xml/ns/dbchangelog-ext/partitionctl.xsd">

    <changeSet author="strict" id="prefixed" runInTransaction="false">
        <ext:createPartitionedTableIndex schemaName="public" tableName="orders"
                                         indexName="idx_prefixed_child">
            <ext:column name="created_at" descending="true"/>
        </ext:createPartitionedTableIndex>
    </changeSet>

</databaseChangeLog>
