<?xml version="1.0" encoding="UTF-8"?>
<!--
  A complete, minimal consumer of the liquibase-partitionctl extension, resolved from
  Maven Central the way any adopter would. Nothing here is copied from the extension's
  own build: if this project runs, the published artifact works.

  Run it against a throwaway PostgreSQL with `make lb-adopter` from the repository root,
  or against your own database:

    mvn liquibase:update -Ddb.url=jdbc:postgresql://host:5432/db \
                         -Ddb.username=me -Ddb.password=secret

  The one thing people get wrong: the extension belongs in the liquibase-maven-plugin's
  OWN <dependencies>, not the project's. In the project's dependencies it is invisible to
  Liquibase and every <ext:...> tag fails with "no declaration can be found".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>partitionctl-liquibase-example</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <!-- Overridable so the same pom drives the local demo database and yours. -->
    <db.url>jdbc:postgresql://localhost:5559/postgres</db.url>
    <db.username>postgres</db.username>
    <db.password>pw</db.password>
  </properties>


  <build>
    <plugins>
      <plugin>
        <groupId>org.liquibase</groupId>
        <artifactId>liquibase-maven-plugin</artifactId>
        <version>4.33.0</version>
        <configuration>
          <changeLogFile>changelogs/changelog.xml</changeLogFile>
          <url>${db.url}</url>
          <username>${db.username}</username>
          <password>${db.password}</password>
          <driver>org.postgresql.Driver</driver>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
          </dependency>
          <!-- The extension, straight from Maven Central. -->
          <dependency>
            <groupId>io.github.atulsinha87</groupId>
            <artifactId>liquibase-partitionctl</artifactId>
            <version>0.1.3</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
