<?xml version="1.0" encoding="UTF-8"?>
<!--
  partitionctl Liquibase extension schema.

  Liquibase strips the protocol from the xsi:schemaLocation URL and resolves the
  remainder as a CLASSPATH RESOURCE, so this file must live in the jar at exactly
  www/liquibase/org/... that is, www.liquibase.org/xml/ns/dbchangelog-ext/partitionctl.xsd.
  Nothing is ever fetched over the network.

  Attribute names here must match the Java property names EXACTLY. A mismatch binds to
  null SILENTLY, with no error of any kind. XsdBindingTest fails the build on a mismatch.
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://www.liquibase.org/xml/ns/dbchangelog-ext/partitionctl"
            xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext/partitionctl"
            elementFormDefault="qualified">

    <xsd:element name="createPartitionedTableIndex">
        <xsd:complexType>
            <!--
              An xsd:choice, not a single wildcard, so BOTH child forms parse:

                <ext:column .../>   our own namespace, declared explicitly below
                <column .../>       unprefixed, so it lands in the dbchangelog namespace and
                                    is matched by the ##other wildcard

              processContents="strict" is deliberate and sufficient: the validator resolves
              `column` from the dbchangelog schema the changelog already declares in its own
              xsi:schemaLocation. No xsd:import, so the jar is not coupled to one Liquibase
              version, and a misspelled element name is still rejected at parse time
              ("The matching wildcard is strict, but no declaration can be found for element
              'colum'"). lax would silently accept the misspelling and leave it to the Java
              validate() backstop.
            -->
            <xsd:choice minOccurs="1" maxOccurs="unbounded">
                <xsd:element name="column">
                    <xsd:complexType>
                        <xsd:attribute name="name" type="xsd:string" use="required"/>
                        <xsd:attribute name="descending" type="xsd:boolean" use="optional"/>
                    </xsd:complexType>
                </xsd:element>
                <xsd:any namespace="##other" processContents="strict"/>
            </xsd:choice>

            <xsd:attribute name="schemaName" type="xsd:string" use="required"/>
            <xsd:attribute name="tableName" type="xsd:string" use="required"/>
            <xsd:attribute name="indexName" type="xsd:string" use="required"/>
            <!-- lock_timeout for the concurrent index builds. Default 15min. -->
            <xsd:attribute name="lockTimeout" type="xsd:string" use="optional"/>
            <!-- lock_timeout for ALTER INDEX ... ATTACH PARTITION. Default 30s. -->
            <xsd:attribute name="attachLockTimeout" type="xsd:string" use="optional"/>
            <!-- seconds to sleep between leaf partitions. Default none. -->
            <xsd:attribute name="paceSeconds" type="xsd:integer" use="optional"/>

            <!--
              Index shape. All three are carried identically into the parent CREATE INDEX ON ONLY
              and into every leaf CREATE INDEX CONCURRENTLY, because a parent and child that
              disagree on any of them cannot attach: PostgreSQL 17.10 answers
              "cannot attach index ... DETAIL: The index definitions do not match."
            -->

            <!--
              CREATE UNIQUE INDEX. Default false. PostgreSQL requires a unique index on a
              partitioned table to include every partitioning column and reports the missing one
              by name, so that check is left to the server.
            -->
            <xsd:attribute name="unique" type="xsd:boolean" use="optional"/>

            <!--
              Index access method: btree (PostgreSQL's default), gin, gist, brin, hash, spgist.
              Emitted as a QUOTED identifier, so it is matched case-sensitively against pg_am.
              Measured: USING "BTREE" fails where USING "btree" works. Write it lowercase.
            -->
            <xsd:attribute name="using" type="xsd:string" use="optional"/>

            <!--
              Partial-index predicate, without the WHERE keyword.

              RAW SQL. It is not escaped and cannot be: a predicate is an arbitrary expression, so
              there is no parameter to bind it to, and it is concatenated verbatim into the
              CREATE INDEX text exactly as the body of a Liquibase sql tag is. Anyone who can
              edit the changelog can already run arbitrary SQL through Liquibase, so this opens no
              new door. But a changelog generated by string concatenation from untrusted input
              would carry that injection straight through and nothing here would catch it.
            -->
            <xsd:attribute name="where" type="xsd:string" use="optional"/>
        </xsd:complexType>
    </xsd:element>

    <!--
      Drops a partitioned index, every child index attached to it, and any free-standing
      leftover an interrupted build left behind. No child elements: the objects to remove are
      discovered from the catalog, never listed by hand.

      confirmExclusiveLock is optional in the SCHEMA and required by the CHANGE whenever an
      attached tree is actually present. Marking it use="required" here would demand it on runs
      that take no exclusive lock at all: a leftovers-only cleanup is fully online, and a
      re-run with nothing left to drop touches nothing.
    -->
    <xsd:element name="dropPartitionedTableIndex">
        <xsd:complexType>
            <xsd:attribute name="schemaName" type="xsd:string" use="required"/>
            <xsd:attribute name="tableName" type="xsd:string" use="required"/>
            <xsd:attribute name="indexName" type="xsd:string" use="required"/>
            <!-- acknowledges AccessExclusiveLock on the parent table AND every leaf at once. -->
            <xsd:attribute name="confirmExclusiveLock" type="xsd:boolean" use="optional"/>
            <!-- lock_timeout for DROP INDEX CONCURRENTLY on leftovers. Default 15min. -->
            <xsd:attribute name="lockTimeout" type="xsd:string" use="optional"/>
            <!-- lock_timeout for the exclusive DROP INDEX on the parent. Default 5s. -->
            <xsd:attribute name="exclusiveLockTimeout" type="xsd:string" use="optional"/>
            <!-- attempts at the exclusive drop, with doubling backoff. Default 5. -->
            <xsd:attribute name="exclusiveRetries" type="xsd:integer" use="optional"/>
            <!--
              Hard ceiling on the WHOLE exclusive drop, every attempt and backoff together,
              applied as statement_timeout. Default 5min.

              This is the only bound that is not per-lock. exclusiveLockTimeout caps ONE lock
              acquisition, and DROP INDEX on a partitioned parent takes one AccessExclusiveLock
              per leaf plus two, holding each while it waits for the next, so the waits add.
              Measured on 17.10, 8 leaves with two contended and exclusiveLockTimeout at its 5s
              default: the drop held the table for 6876 ms. Hitting this ceiling cancels the
              statement, which rolls the retry block back completely: nothing is dropped, no
              DATABASECHANGELOG row is written, and re-running retries.
            -->
            <xsd:attribute name="exclusiveTotalTimeout" type="xsd:string" use="optional"/>
        </xsd:complexType>
    </xsd:element>

    <!--
      Rebuilds every leaf index of an existing partitioned index. No child elements and no
      column list: the columns are whatever the index already has, and the leaves are
      discovered from the catalog.

      There is no attachLockTimeout here, unlike createPartitionedTableIndex. REINDEX INDEX
      CONCURRENTLY swaps the index in place and the pg_inherits attachment survives, so this
      operation never emits ALTER INDEX ... ATTACH PARTITION and never asks for an
      AccessExclusiveLock.
    -->
    <xsd:element name="reindexPartitionedTableIndex">
        <xsd:complexType>
            <xsd:attribute name="schemaName" type="xsd:string" use="required"/>
            <xsd:attribute name="tableName" type="xsd:string" use="required"/>
            <xsd:attribute name="indexName" type="xsd:string" use="required"/>
            <!-- lock_timeout for REINDEX INDEX CONCURRENTLY and for dropping leftovers. Default 15min. -->
            <xsd:attribute name="lockTimeout" type="xsd:string" use="optional"/>
            <!-- seconds to sleep after each leaf that was actually rebuilt. Default none. -->
            <xsd:attribute name="paceSeconds" type="xsd:integer" use="optional"/>
        </xsd:complexType>
    </xsd:element>

    <!--
      The three read-only gates. They take no child elements and emit no SQL beyond one SELECT
      against pg_catalog.

      Their attributes are schemaName / tableName / indexName: the same names the changes above
      use, and the same names Liquibase's own preconditions use
      (liquibase.precondition.core.IndexExistsPrecondition declares exactly those three).

      An earlier draft used the bare schema / table / index and justified it here as "inherited
      from the already-published gate". That was false: nothing has ever been published, so there
      were no existing changelogs to keep parsing, and the asymmetry only cost adopters. The
      obvious carry-over from createPartitionedTableIndex failed to parse with a message that
      named the offending attribute but not the correct one.
    -->
    <xsd:element name="partitionctlIndexGate">
        <xsd:complexType>
            <xsd:attribute name="schemaName" type="xsd:string" use="required"/>
            <xsd:attribute name="tableName" type="xsd:string" use="required"/>
            <xsd:attribute name="indexName" type="xsd:string" use="required"/>
            <!--
              Also require indisvalid on the partitioned parent. Default FALSE: that flag does not
              affect query planning and, once an invalid child has been attached, nothing but a
              full rebuild clears it (limitation L3). Defaulting to true would make a runAlways
              deploy fail forever with no repair path.
            -->
            <xsd:attribute name="requireValidParent" type="xsd:boolean" use="optional"/>
        </xsd:complexType>
    </xsd:element>

    <!--
      The inverse gate: the partitioned index is gone AND no orphaned child index survives on any
      leaf. There is no requireValidParent here because there is no parent left to have a flag.
    -->
    <xsd:element name="partitionctlIndexAbsentGate">
        <xsd:complexType>
            <xsd:attribute name="schemaName" type="xsd:string" use="required"/>
            <xsd:attribute name="tableName" type="xsd:string" use="required"/>
            <xsd:attribute name="indexName" type="xsd:string" use="required"/>
        </xsd:complexType>
    </xsd:element>

    <!--
      Catalog health plus no _ccnew / _ccold leftover from an interrupted REINDEX INDEX
      CONCURRENTLY. No `since` attribute, and there cannot be one: a rebuilt index differs from
      its predecessor only in relfilenode, so "was reindexed" is not observable in the catalog and
      this extension keeps no state store.

      No requireValidParent either. Preconditions in one block are ANDed, so an adopter who wants
      the parent checked composes partitionctlIndexGate requireValidParent="true" alongside it.
    -->
    <xsd:element name="partitionctlReindexGate">
        <xsd:complexType>
            <xsd:attribute name="schemaName" type="xsd:string" use="required"/>
            <xsd:attribute name="tableName" type="xsd:string" use="required"/>
            <xsd:attribute name="indexName" type="xsd:string" use="required"/>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
